# Copy the non-secret values from the platform-infra apply output.
# Values may be pasted in Terraform's key = "value" format.
app_name = "hello-world-dev"
application_url = "http://hello-world-dev-alb-961493300.us-east-1.elb.amazonaws.com"
aws_region = "us-east-1"
container_image = "public.ecr.aws/nginx/nginx:latest"
ecs_cluster_name = "platform-apps-dev-cluster"
ecs_service_name = "hello-world-dev-service"
ecs_task_family = "hello-world-dev-task"
github_deploy_role_arn = "arn:aws:iam::136889124753:role/hello-world-dev-github-deploy"
github_repository = "itsample05/platform-apps-hello-world"

# Not an infrastructure output: set this to the Docker Hub namespace used to publish this app.
dockerhub_username = "YOUR_DOCKERHUB_NAMESPACE"
